# Ghostty configuration for Linux/NixOS
# font-family = D2CodingLigature Nerd Font
# Monoplex Nerd
font-family = GLG Nerd Font Mono
font-size = 15.1

term = xterm-ghostty

# Scrollback buffer limit (3MB instead of default 10MB)
# Reduces memory usage and improves performance with long Claude Code sessions
scrollback-limit = 3000000

# Window decoration: server = WM manages borders (i3 child-border works)
window-decoration = server

# 윈도우 패딩 (좌/우)
window-padding-x = 10,10

# 윈도우 패딩 (상/하)
window-padding-y = 10,10

# shell integration : none
shell-integration = none
shell-integration-features = cursor, sudo, no-title

# 창, pane 등을 닫을 때 확인창을 표시하지 않음.
confirm-close-surface = false

# 마우스 스크롤 멀티플라리어
mouse-scroll-multiplier = 0.7

# 투명도 설정 : 95%
background-opacity = 0.95
background-blur-radius = 20
mouse-hide-while-typing = true

# Clipboard settings
clipboard-paste-protection = false
copy-on-select = clipboard

# Theme
theme = Dracula

# Cursor color (match kitty/wezterm: #ff4769 핑크 — 테마 상관없이 잘보임)
# kitty의 'cursor_text_color background' 효과:
# 커서 위 글자색을 어두운 배경값으로 박아서 "사라지게" 만든다.
cursor-color = #ff4769
cursor-text = #0d0e1c

# alt+u / alt+v 는 ghostty가 잡지 않고 tmux로 흘려보낸다.
#
# 예전에는 여기서 scroll_page_fractional 로 잡았는데, tmux를 켜면 두 키가
# 통째로 죽었다. tmux는 alternate screen을 쓰므로 ghostty 스크롤백이 비어
# 있어 ghostty 쪽 스크롤은 아무 일도 안 하고, 그러면서 키는 소비해버려
# tmux의 copy-mode 바인딩까지 도달하지 못했다. 양쪽 다 죽는 구조였다.
#
# 스크롤 담당은 tmux copy-mode로 일원화한다 (configs/tmux.conf 참고).
# tmux 없이 쓸 때의 스크롤은 ghostty 기본 shift+page_up/down 과 마우스 휠.
